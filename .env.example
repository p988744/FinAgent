# LLM Configuration (OpenAI-compatible API)
# Works with OpenAI, Ollama, or any OpenAI-compatible endpoint
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Embedding Configuration (OpenAI-compatible API)
# Leave BASE_URL and API_KEY empty to share LLM endpoint
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Example 1: Use OpenAI (default)
# LLM_API_KEY=sk-proj-xxx
# LLM_BASE_URL=                           # Empty = use OpenAI
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=                     # Empty = use LLM_BASE_URL (OpenAI)
# EMBEDDING_API_KEY=                      # Empty = use LLM_API_KEY
#
# Example 2: Use local LLM (e.g., Ollama)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1  # Custom endpoint
# LLM_MODEL=qwen2.5:7b
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_BASE_URL=                     # Empty = use LLM_BASE_URL
# EMBEDDING_API_KEY=                      # Empty = use LLM_API_KEY
#
# Example 3: Use local LLM + OpenAI embedding
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# EMBEDDING_API_KEY=sk-proj-xxx           # Provide OpenAI key
# EMBEDDING_BASE_URL=                     # Empty = use OpenAI default
# EMBEDDING_MODEL=text-embedding-3-small
#
# Example 4: Use OpenAI LLM + local embedding
# LLM_API_KEY=sk-proj-xxx
# LLM_BASE_URL=                           # Empty = use OpenAI
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_API_KEY=custom-key
# EMBEDDING_BASE_URL=http://embedding-server:8080/v1
# EMBEDDING_MODEL=bge-m3

# Vector Database
CHROMA_PERSIST_DIRECTORY=./data/vector_db
CHROMA_COLLECTION_NAME=legal_documents

# Application Settings
APP_ENV=development
APP_NAME="Legal Research Agent"
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# FSC Scraping (金管會)
FSC_BASE_URL=https://www.fsc.gov.tw
SCRAPING_DELAY_SECONDS=1
SCRAPING_MAX_RETRIES=3
SCRAPING_TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
MAX_DOCUMENT_SIZE_MB=50

# Rate Limiting
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT_SECONDS=60
