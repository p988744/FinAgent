{
  "name": "finagent-desktop",
  "version": "0.0.2",
  "description": "FinAgent - Cross-platform Desktop Application for Taiwan Financial Legal Research",
  "main": "electron/main.js",
  "author": "FinAgent Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "./node_modules/.bin/electron .",
    "dev": "concurrently \"npm run dev:python\" \"npm run dev:electron\"",
    "dev:python": "uv run python -m uvicorn finagent.main:app --reload --port 8000",
    "dev:electron": "./node_modules/.bin/electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "electron-log": "^5.1.0",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "27.3.11",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.finagent.desktop",
    "productName": "FinAgent",
    "directories": {
      "output": "dist",
      "buildResources": "electron/build"
    },
    "files": [
      "electron/**/*",
      "!electron/renderer/src/**/*"
    ],
    "extraResources": [
      {
        "from": "python-dist/",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/build/icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/build/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
