# LLM Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.0

# Local LLM (OpenAI-compatible API)
# Chat/Completion Provider
USE_LOCAL_LLM=false
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_API_KEY=ollama

# Embedding Provider (independent from LLM)
USE_LOCAL_EMBEDDING=false
LOCAL_EMBEDDING_MODEL=bge-m3
# Optional: Use different endpoint for embeddings (leave empty to use LOCAL_LLM_BASE_URL)
LOCAL_EMBEDDING_BASE_URL=
# Optional: Use different API key for embeddings (leave empty to use LOCAL_LLM_API_KEY)
LOCAL_EMBEDDING_API_KEY=

# Vector Database
CHROMA_PERSIST_DIRECTORY=./data/vector_db
CHROMA_COLLECTION_NAME=legal_documents

# Application Settings
APP_ENV=development
APP_NAME="Legal Research Agent"
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# FSC Scraping (金管會)
FSC_BASE_URL=https://www.fsc.gov.tw
SCRAPING_DELAY_SECONDS=1
SCRAPING_MAX_RETRIES=3
SCRAPING_TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
MAX_DOCUMENT_SIZE_MB=50

# Rate Limiting
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT_SECONDS=60
