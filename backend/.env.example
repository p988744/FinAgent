# LLM Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.0

# Local LLM (OpenAI-compatible API)
# If you provide these, they will override OpenAI for chat/completion
# Leave empty to use OpenAI by default
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=

# Local Embedding (OpenAI-compatible API)
# If you provide LOCAL_EMBEDDING_MODEL, it will override OpenAI for embeddings
# URL and API key are optional (will use LOCAL_LLM_* if not provided)
LOCAL_EMBEDDING_MODEL=
LOCAL_EMBEDDING_BASE_URL=
LOCAL_EMBEDDING_API_KEY=

# Example: To use local LLM (e.g., Ollama)
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_MODEL=qwen2.5:7b
#
# Example: To use local embedding
# LOCAL_EMBEDDING_MODEL=bge-m3
# (URL and API key will use LOCAL_LLM_* values)
#
# Example: To use separate embedding endpoint
# LOCAL_EMBEDDING_MODEL=bge-m3
# LOCAL_EMBEDDING_BASE_URL=http://embedding-server:8080/v1
# LOCAL_EMBEDDING_API_KEY=custom-key

# Vector Database
CHROMA_PERSIST_DIRECTORY=./data/vector_db
CHROMA_COLLECTION_NAME=legal_documents

# Application Settings
APP_ENV=development
APP_NAME="Legal Research Agent"
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# FSC Scraping (金管會)
FSC_BASE_URL=https://www.fsc.gov.tw
SCRAPING_DELAY_SECONDS=1
SCRAPING_MAX_RETRIES=3
SCRAPING_TIMEOUT_SECONDS=30

# Feature Flags
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
MAX_DOCUMENT_SIZE_MB=50

# Rate Limiting
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT_SECONDS=60
